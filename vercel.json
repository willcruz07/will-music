{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci -w @will-music/web",
  "buildCommand": "npm run build -w @will-music/web && rm -rf dist && cp -r apps/web/dist dist",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!assets/|icons/|.*\\.[a-z0-9]+$).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
